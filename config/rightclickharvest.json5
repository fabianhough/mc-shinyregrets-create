  // The rest match RightClickHarvest 4.7.2's own defaults.
  "harvestInRadius": true,
  "hungerLevel": "NONE",
  "experienceType": "NONE",
  "showServerWarning": true,
  "hasUserBeenWarnedForNotUsingHoe": false
}
